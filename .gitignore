# RStudio / R session state
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Input data - large (multi-GB rasters/shapefiles) and includes sensitive
# IDP location data that should not go into version control
input_data/

# Derived/cached outputs - reproducible from input_data + scripts
output/
_cache/
testing.csv
MSNA_NGA_samplingframe_cluster_2026.csv
Rplots.pdf
__pycache__/

# Scratch/diagnostic scripts and their run logs from debugging sessions
diag_*.R
diag_*.txt
temp_stage1_only.R
*_err.txt
*_err[0-9]*.txt
*_log.txt
*_log[0-9]*.txt
run_log_*.txt
*.log

# Raw partner correspondence (Outlook .msg exports, draft replies) - this
# is a public repo; personal email content/PII should not go into it, same
# reasoning as the input_data/ exclusion above.
resampling/input/partner_raw_comms/

# Assist tool local settings (machine/user-specific)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# OS
Thumbs.db
Desktop.ini
